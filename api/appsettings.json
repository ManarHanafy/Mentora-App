{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "MentalHealthApi",
    "Audience": "MentalHealthClient",
    "ExpirationMinutes": 60
  },
  "AdminSeed": {
    "Email": "SET_IN_ENVIRONMENT",
    "Password": "SET_IN_ENVIRONMENT",
    "Username": "admin",
    "FirstName": "System",
    "LastName": "Admin"
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 20
  },
  "MentoraAI": {
    "BaseUrl": "https://mentorra.pythonanywhere.com",
    "TimeoutSeconds": 30
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "UseStartTls": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4200",
      "https://yourdomain.com"
    ]
  },
  "CrisisResources": {
    "DefaultLocale": "global",
    "Locales": {
      "global": {
        "Message": "You are not alone. Immediate help is available. Please reach out to one of the resources below.",
        "Resources": [
          {
            "Name": "International Association for Suicide Prevention",
            "Type": "Hotline Directory",
            "Contact": "https://www.iasp.info/resources/Crisis_Centres/",
            "Description": "Find a crisis centre in your country.",
            "Available24Hours": true
          },
          {
            "Name": "Befrienders Worldwide",
            "Type": "Emotional Support",
            "Contact": "https://www.befrienders.org",
            "Description": "Emotional support for people in crisis around the world.",
            "Available24Hours": true
          },
          {
            "Name": "Emergency Services",
            "Type": "Emergency",
            "Contact": "911 / 999 / 112 (local emergency number)",
            "Description": "Contact local emergency services immediately if you or someone else is in immediate danger.",
            "Available24Hours": true
          }
        ],
        "ImmediateAdvice": "If you are in immediate danger, call your local emergency number now and talk to someone you trust."
      },
      "us": {
        "Message": "Immediate support is available in the United States.",
        "Resources": [
          {
            "Name": "988 Suicide & Crisis Lifeline",
            "Type": "Phone Support",
            "Contact": "Call or text 988",
            "Description": "Free and confidential support 24/7.",
            "Available24Hours": true
          },
          {
            "Name": "Crisis Text Line",
            "Type": "Text Support",
            "Contact": "Text HOME to 741741",
            "Description": "24/7 support via text in the US.",
            "Available24Hours": true
          }
        ],
        "ImmediateAdvice": "If there is immediate danger, call 911 now."
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"],
    "Properties": {
      "ApplicationName": "MentalHealthApi"
    }
  },
  "AllowedHosts": "*"
}
